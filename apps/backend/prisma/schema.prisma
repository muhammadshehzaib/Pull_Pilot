generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  githubId      String         @unique
  username      String
  email         String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  vault         Vault?
  repositories  Repository[]
  installations Installation[]
  subscriptions Subscription[]
  installationClaims InstallationClaim[]
  usageLedgers UsageLedger[]

  @@map("users")
}

/// One-time state linking an authenticated user to a GitHub App setup callback.
model InstallationClaim {
  id        String   @id @default(uuid())
  stateHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("installation_claims")
}

enum AiProvider {
  GEMINI
  OPENAI
  CLAUDE
  GROK
}

model Vault {
  id                 String     @id @default(uuid())
  userId             String     @unique
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           AiProvider @default(GEMINI)
  encryptedGeminiKey String     @db.Text
  iv                 String
  authTag            String
  salt               String     // per-record salt for scrypt key derivation
  updatedAt          DateTime   @updatedAt

  @@map("vaults")
}

enum PlanTier {
  FREE
  INDIE
  TEAM
}

/// A paid subscription held with Polar (our merchant of record).
/// Entitlement is derived from these rows and mirrored onto Installation.plan,
/// which is what the quota gate reads.
model Subscription {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             String    @default("polar")
  /// Nullable: a user can have a Polar customer record before any subscription exists.
  polarCustomerId      String?
  /// Unique so a redelivered Polar webhook cannot create a duplicate row.
  /// Postgres excludes NULLs from unique constraints, so orders without a
  /// subscription (one-time purchases) do not collide.
  polarSubscriptionId  String?   @unique
  polarProductId       String?
  plan                 PlanTier  @default(FREE)
  status               String    @default("inactive")
  billingCycle         String    @default("monthly")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([polarCustomerId])
  @@map("subscriptions")
}

model Installation {
  id                   String        @id @default(uuid())
  githubInstallationId BigInt        @unique
  createdByGithubId    String?
  accountLogin         String
  accountType          String        @default("User") // "User" or "Organization"
  avatarUrl            String?
  plan                 PlanTier      @default(FREE)
  userId               String?
  user                 User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  repositories         Repository[]
  usageLedgers         UsageLedger[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("installations")
}

model Repository {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId String?
  installation   Installation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  githubRepoId   BigInt
  fullName       String
  isPrivate      Boolean       @default(false)
  webhookId      String?
  isActive       Boolean       @default(true)
  defaultBranch  String?       // e.g. "main" or "master"; used for push/branch audits
  lastScannedSha String?       // default-branch head last seen by the repo poller (webhook-less repos)
  createdAt      DateTime      @default(now())
  analysisJobs   AnalysisJob[]
  cachedFiles    CachedFile[]
  cachedImports  CachedImport[]
  rules          RepositoryRule[]
  testDrafts     TestDraft[]
  behavioralConfig Json?
  behavioralRuns BehavioralRun[]

  /// Phase 8: opt-in historical intelligence (default off).
  historicalIntelligenceEnabled Boolean  @default(false)
  historicalRevision            Int      @default(0)
  historicalAggregatedRevision  Int      @default(-1)
  historicalAggregatedAt        DateTime?
  findingOccurrences             FindingOccurrence[]
  historicalPatterns             HistoricalPattern[]
  feedbackAdaptationEnabled      Boolean @default(false)
  feedbackAdaptationRevision     Int @default(0)
  ruleAuditEvents                RuleAuditEvent[]
  analyticsStartedAt             DateTime @default(now())
  reviewAnalyticsFacts           ReviewAnalyticsFact[]

  @@map("repositories")
  @@unique([installationId, githubRepoId])
}

/// Severity levels a stored rule can report, mirroring the AI finding
/// taxonomy (finding-taxonomy.ts) so a rule's severity and a model finding's
/// severity rank identically.
enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

/// Finding categories a stored rule can file violations under, mirroring
/// finding-taxonomy.ts.
enum FindingCategory {
  SECURITY
  BUG
  CORRECTNESS
  PERFORMANCE
  ARCHITECTURE
  MAINTAINABILITY
  STYLE
  TESTING
}

/// How a repository rule is enforced.
///
/// LLM            — wording handed to the model as an additional user rule.
/// DETERMINISTIC  — regular expression checked against every added line in
///                   the diff; no model judgement involved.
/// BOTH           — injected into the prompt and checked deterministically.
enum RuleEnforcement {
  LLM
  DETERMINISTIC
  BOTH
}

/// An engineering rule configured per repository from the dashboard, kept in
/// the database alongside (and merged with) .aipr.yml guidelines so a team can
/// manage rules without committing a config file.
model RepositoryRule {
  id           String          @id @default(uuid())
  repositoryId String
  repository   Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  /// Rule statement injected into the model prompt. Required for LLM/BOTH.
  guideline    String?
  /// JavaScript regular expression matched against added diff lines.
  /// Required for DETERMINISTIC/BOTH; validated at write time.
  pattern      String?
  severity     FindingSeverity @default(MEDIUM)
  category     FindingCategory @default(MAINTAINABILITY)
  enforcement  RuleEnforcement @default(LLM)
  enabled      Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  checks       RuleCheck[]
  origin       String @default("MANUAL")
  sourceOccurrenceId String?
  sourceOccurrence FindingOccurrence? @relation(fields: [sourceOccurrenceId], references: [id], onDelete: SetNull)
  creationKey String?
  revision Int @default(0)
  auditEvents RuleAuditEvent[]

  @@unique([repositoryId, creationKey])
  @@index([repositoryId])
  @@map("repository_rules")
}

/// Outcome of one rule during one analysis job: PASS (no violating added
/// lines), FAIL (at least one), or SKIPPED (LLM-only rule — pass/fail is the
/// model's judgement, not a deterministic result).
///
/// `ruleName` is snapshotted so the record still reads sensibly after the
/// rule itself is deleted (the FK then goes null).
model RuleCheck {
  id             String          @id @default(uuid())
  analysisJobId  String
  analysisJob    AnalysisJob     @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  ruleId         String?
  rule           RepositoryRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  ruleName       String
  status         RuleCheckStatus
  violationCount Int             @default(0)
  createdAt      DateTime        @default(now())

  @@unique([analysisJobId, ruleId])
  @@index([ruleId])
  @@map("rule_checks")
}

enum RuleCheckStatus {
  PASS
  FAIL
  SKIPPED
}

/// Which deterministic security engine produced a check or finding.
enum SecurityProbe {
  SAST
  SECRETS
  DEPENDENCIES
}

/// Outcome of one security probe during one analysis job: PASS (scanned clean),
/// FAIL (at least one finding), SKIPPED (nothing applicable to scan), or
/// DEGRADED (ran with reduced coverage — e.g. the optional Semgrep pass or the
/// live OSV lookup was unavailable, so a clean result is not a full scan).
enum SecurityCheckStatus {
  PASS
  FAIL
  SKIPPED
  DEGRADED
}

/// One outcome row per security probe per analysis job, mirroring rule_checks
/// so the deterministic security layer has a durable audit trail independent
/// of the findings JSON blob.
///
/// A review normally writes at most three of these (SAST, SECRETS,
/// DEPENDENCIES). `ruleName` is a human label and `ruleKey` an opaque key for
/// the unique index; the finding details themselves live in
/// `analysis_jobs.results.suggestions`. `detail` explains a DEGRADED/SKIPPED
/// status (which optional input was unavailable, or why nothing was scanned).
model SecurityCheck {
  id            String              @id @default(uuid())
  analysisJobId String
  analysisJob   AnalysisJob         @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  probe         SecurityProbe
  ruleKey       String
  ruleName      String
  status        SecurityCheckStatus
  findingCount  Int                 @default(0)
  detail        String?
  createdAt     DateTime            @default(now())

  @@unique([analysisJobId, probe, ruleKey])
  @@index([probe])
  @@index([analysisJobId])
  @@map("security_checks")
}

/// A single file's content, encrypted, keyed by its Git blob SHA so identical
/// content is stored once and never refetched. Used to assemble review context
/// beyond the diff.
///
/// This holds customer source code, so rows are deleted the moment their
/// repository is disconnected (removed from the installation, uninstalled, or
/// deactivated from the dashboard). A sweeper additionally deletes anything
/// past `expiresAt` when a finite retention window is configured. Keeping it
/// content-addressed also means a rebase or an unrelated commit does not
/// create a new row.
model CachedFile {
  id            String     @id @default(uuid())
  repositoryId  String
  repository    Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  blobSha       String
  /// Last known path for this blob. Authoritative path always comes from a
  /// fresh tree listing; this is only a human-readable hint.
  path          String
  sizeBytes     Int
  /// AES-256-GCM envelope from EncryptionService.encrypt (hex).
  encryptedData String
  iv            String
  authTag       String
  salt          String
  createdAt     DateTime   @default(now())
  /// Absolute expiry; enforced by the cache sweep, not by read time.
  /// Null means no expiry: the row lives until its repository is disconnected.
  expiresAt     DateTime?

  @@unique([repositoryId, blobSha])
  @@index([expiresAt])
  @@map("cached_files")
}

/// Extracted imports are source-derived data, encrypted and isolated per repository.
model CachedImport {
  id            String     @id @default(uuid())
  repositoryId  String
  repository    Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  blobSha       String
  parserVersion Int
  encryptedData String
  iv            String
  authTag       String
  salt          String
  createdAt     DateTime   @default(now())
  expiresAt     DateTime?

  @@unique([repositoryId, blobSha, parserVersion])
  @@index([expiresAt])
  @@map("cached_imports")
}

enum EventType {
  PULL_REQUEST
  PUSH
}

enum JobStatus {
  QUEUED
  FETCHING
  ANALYZING
  GENERATING
  POSTING
  RUNNING
  RETRYING
  COMPLETED
  FAILED
  SKIPPED
  CANCELLED
  TIMEOUT
}

model AnalysisJob {
  completedAt                   DateTime?
  analyticsRevision             Int @default(0)
  analyticsHash                 String?
  analyticsFacts                ReviewAnalyticsFact[]
  findingSnapshot               Int      @default(0)
  findingSnapshotHash           String?
  id              String          @id @default(uuid())
  repositoryId    String
  repository      Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  eventType       EventType
  referenceId     String          // PR number or Commit SHA
  status          JobStatus       @default(QUEUED)
  results         Json?
  commitSha       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  ruleChecks         RuleCheck[]
  securityChecks     SecurityCheck[]
  testDrafts         TestDraft[]
  behavioralRuns     BehavioralRun[]
  findingOccurrences FindingOccurrence[]

  @@unique([repositoryId, eventType, referenceId, commitSha])
  @@index([commitSha])
  @@index([repositoryId, status, createdAt])
  @@map("analysis_jobs")
}

/// Immutable, bounded numeric snapshot. No source, notes or generated code.
model ReviewAnalyticsFact {
  id String @id @default(uuid())
  repositoryId String
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  analysisJobId String
  analysisJob AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  artifactRevision Int
  findingSnapshot Int
  referenceId String
  eventType EventType
  completedAt DateTime
  jobCreatedAt DateTime
  expiresAt DateTime
  timestampQuality String
  metricsVersion String
  riskAlgorithmVersion String
  configurationSignature String
  riskScore Float?
  criticalCount Int
  highCount Int
  mediumCount Int
  lowCount Int
  infoCount Int
  securityCount Int
  testGapCount Int?
  coverage Json
  @@unique([analysisJobId, artifactRevision])
  @@index([repositoryId, completedAt])
  @@index([repositoryId, referenceId, completedAt])
  @@index([expiresAt])
  @@map("review_analytics_facts")
}

enum BehavioralRunStatus {
  NOT_RUN
  QUEUED
  RUNNING
  PASSED
  FAILED
  TIMED_OUT
  ERROR
}

/// Plans and bounded step outcomes only; never screenshots, DOM, console or credentials.
model BehavioralRun {
  id String @id @default(uuid())
  analysisJobId String
  analysisJob AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  repositoryId String
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  requestKey String
  status BehavioralRunStatus @default(NOT_RUN)
  headSha String
  deploymentId Int?
  previewUrl String?
  workflowSha String
  workflowRef String
  dispatchHash String
  ciRunId String?
  plan Json
  evidence Json?
  reason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deadlineAt DateTime
  expiresAt DateTime

  @@unique([analysisJobId, requestKey])
  @@index([repositoryId, createdAt])
  @@index([status, deadlineAt])
  @@index([expiresAt])
  @@map("behavioral_runs")
}

/// Lifecycle of an AI-drafted test.
///
/// DRAFT          — generated/edited, awaiting an explicit "create PR".
/// PR_CREATED     — a PR was opened (or reused) for this draft.
/// DISCARDED      — the developer threw it away; the row is kept so a stale
///                  link or a retried request resolves cleanly.
enum TestDraftStatus {
  DRAFT
  PR_CREATED
  DISCARDED
}

/// One AI-drafted test, produced from a single test-gap scenario.
///
/// Persisted (rather than kept client-side) so the draft survives a reload, a
/// failed GitHub call can be retried without regenerating, and every read is
/// scoped to the owning repository's user. `targetContent` is the accepted
/// (possibly edited) test body; `baseSha` is the commit the draft was written
/// against and is re-checked before any write.
model TestDraft {
  id              String          @id @default(uuid())
  repositoryId    String
  repository      Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  analysisJobId   String?
  analysisJob     AnalysisJob?    @relation(fields: [analysisJobId], references: [id], onDelete: SetNull)
  /// Denormalized owner for cheap cross-repo listing; authority is still the
  /// repository relation, which every query also filters on.
  userId          String
  /// Snapshot of the gap scenario this draft covers.
  scenario        Json
  sourcePath      String
  targetPath      String
  targetContent   String
  framework       String?
  notes           String?
  /// Best-effort structural note (heuristic delimiter balance, etc). Null when
  /// the cheap check passed cleanly.
  structuralNote  String?
  baseBranch      String
  baseSha         String
  /// Head SHA whose changed source and test-gap scenario the draft was based on.
  /// Null for older records and non-PR jobs.
  sourceHeadSha   String?
  sourcePrNumber  Int?
  status          TestDraftStatus @default(DRAFT)
  branchName      String?
  commitSha       String?
  prNumber        Int?
  prUrl           String?
  error           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([repositoryId])
  @@index([analysisJobId])
  @@index([userId])
  @@map("test_drafts")
}

model UsageLedger {
  id                  String       @id @default(uuid())
  installationId      String?
  installation        Installation? @relation(fields: [installationId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingMonth        String       // format "YYYY-MM"
  publicReviewsCount  Int          @default(0)
  privateReviewsCount Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([installationId, billingMonth])
  @@unique([userId, billingMonth])
  @@map("usage_ledgers")
}

// ─────────────────────────────────────────────
// Phase 8 — Historical Intelligence
// ─────────────────────────────────────────────

/// Developer disposition on one finding.
enum FeedbackDisposition {
  UNREVIEWED
  ACCEPTED
  REJECTED
  NEEDS_REVIEW
}

/// Why a finding was rejected (only meaningful when disposition=REJECTED).
enum RejectionReason {
  FALSE_POSITIVE
  DUPLICATE
  INTENDED_BEHAVIOR
  OUT_OF_SCOPE
  STYLE_PREFERENCE
  OTHER
}

/// Stable, immutable record of one finding in one review snapshot.
///
/// Occurrence identity is separate from pattern identity:
///   - FindingOccurrence.id  → identifies this finding in this review.
///   - FindingOccurrence.fingerprint → groups related findings across reviews.
///
  /// The `snapshotKey` combines job, persisted artifact revision and exact finding
  /// key. Regeneration never rebinds old IDs to different findings.
model FindingOccurrence {
  id             String         @id @default(uuid())
  repositoryId   String
  repository     Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  analysisJobId  String
  analysisJob    AnalysisJob    @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  /// Idempotency key: jobId + artifact revision + exact finding key.
  snapshotKey    String         @unique
  findingKey     String         @default("")
  /// Exact file path as reported; case-preserved.
  filePath       String
  lineNumber     Int
  category       FindingCategory
  severity       FindingSeverity
  /// Primary source engine.
  source         String         // 'LLM' | 'SAST' | 'SECRETS' | 'DEPENDENCIES' | 'RULES'
  /// All contributing source engines (JSON array of FindingSource).
  sources        Json           @default("[]")
  /// Rule keys from deterministic engines (JSON array of strings).
  ruleKeys       Json           @default("[]")
  /// Bounded (≤ 500 chars) human-readable summary of the finding.
  summary        String         @db.VarChar(500)
  /// Versioned cross-review grouping key (fp_v2 preserves file path case).
  fingerprint    String
  /// True when this occurrence is superseded by a newer snapshot for the same job.
  superseded     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  feedback       FindingFeedback?
  workflow       FindingWorkflow?
  createdRules   RepositoryRule[]

  @@index([repositoryId, fingerprint])
  @@index([analysisJobId])
  @@index([repositoryId, createdAt])
  @@map("finding_occurrences")
}

/// Current developer feedback state for one finding occurrence.
///
/// ACCEPTED: considered useful/actionable. Does NOT mean fixed or verified.
/// REJECTED: considered not actionable (see rejectionReason for why).
/// NEEDS_REVIEW: flagged for later human review.
/// UNREVIEWED: default; silence is never acceptance.
model FindingFeedback {
  id                String              @id @default(uuid())
  occurrenceId      String              @unique
  occurrence        FindingOccurrence   @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  actorId           String              // the authenticated userId who last updated
  disposition       FeedbackDisposition @default(UNREVIEWED)
  rejectionReason   RejectionReason?
  /// Optional bounded developer note (≤ 1000 chars). Never logged or sent to model.
  note              String?             @db.VarChar(1000)
  /// Monotonic revision for optimistic concurrency. Incremented on every update.
  revision          Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  events            FindingFeedbackEvent[]

  @@map("finding_feedbacks")
}

/// Append-only audit trail of every feedback change.
model FindingFeedbackEvent {
  id              String              @id @default(uuid())
  feedbackId      String
  feedback        FindingFeedback     @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  actorId         String
  disposition     FeedbackDisposition
  rejectionReason RejectionReason?
  revision        Int
  createdAt       DateTime            @default(now())

  @@index([feedbackId])
  @@map("finding_feedback_events")
}

enum FindingWorkflowStatus {
  OPEN
  DISMISSED
  REPORTED_FIXED
}

model FindingWorkflow {
  id String @id @default(uuid())
  occurrenceId String @unique
  occurrence FindingOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  status FindingWorkflowStatus @default(OPEN)
  actorId String
  revision Int @default(0)
  updatedAt DateTime @updatedAt
  events FindingWorkflowEvent[]
  @@map("finding_workflows")
}

model FindingWorkflowEvent {
  id String @id @default(uuid())
  workflowId String
  workflow FindingWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  actorId String
  fromStatus FindingWorkflowStatus
  status FindingWorkflowStatus
  revision Int
  createdAt DateTime @default(now())
  @@index([workflowId, createdAt])
  @@map("finding_workflow_events")
}

model RuleAuditEvent {
  id String @id @default(uuid())
  repositoryId String
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  ruleId String?
  rule RepositoryRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  actorId String
  action String
  revision Int
  creationKey String?
  createdAt DateTime @default(now())
  @@index([repositoryId, createdAt])
  @@unique([repositoryId, creationKey])
  @@map("rule_audit_events")
}

/// Repository-scoped aggregated pattern, rebuilt from finding occurrences.
///
/// One row per (repositoryId, fingerprint, algorithmVersion).
/// Rebuilt idempotently by the aggregation service — never mutated in place
/// in a way that mixes data from two different algorithm versions.
model HistoricalPattern {
  id                String     @id @default(uuid())
  repositoryId      String
  repository        Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  fingerprint       String
  /// Version string of the fingerprinting algorithm that produced this grouping.
  algorithmVersion  String     @default("fp_v1")
  category          FindingCategory
  /// Primary source engine of the grouped findings.
  source            String
  /// Bounded (≤ 300 chars) representative summary for prompt injection.
  summary           String     @db.VarChar(300)
  /// Count of distinct non-superseded occurrences in the window.
  occurrenceCount   Int        @default(0)
  /// Count of distinct PR referenceIds that contributed (retries excluded).
  distinctPrCount   Int        @default(0)
  acceptedCount     Int        @default(0)
  rejectedCount     Int        @default(0)
  /// Breakdown of rejection reasons as JSON: { FALSE_POSITIVE: n, DUPLICATE: n, … }
  rejectionReasons  Json       @default("{}")
  unreviewedCount   Int        @default(0)
  /// Representative file paths (JSON array of strings, ≤ 10).
  representativePaths Json     @default("[]")
  firstObservedAt   DateTime
  lastObservedAt    DateTime
  /// Freshness timestamp of the last aggregation run.
  aggregatedAt      DateTime   @default(now())
  /// Earliest contribution expiry; stale support must not survive until the next sweep.
  expiresAt         DateTime   @default(now())

  @@unique([repositoryId, fingerprint, algorithmVersion])
  @@index([repositoryId, distinctPrCount])
  @@map("historical_patterns")
}
