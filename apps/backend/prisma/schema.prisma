generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  githubId      String         @unique
  username      String
  email         String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  vault         Vault?
  repositories  Repository[]
  installations Installation[]

  @@map("users")
}

enum AiProvider {
  GEMINI
  OPENAI
  CLAUDE
  GROK
}

model Vault {
  id                 String     @id @default(uuid())
  userId             String     @unique
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           AiProvider @default(GEMINI)
  encryptedGeminiKey String     @db.Text
  iv                 String
  authTag            String
  salt               String     // per-record salt for scrypt key derivation
  updatedAt          DateTime   @updatedAt

  @@map("vaults")
}

enum PlanTier {
  FREE
  INDIE
  TEAM
}

model Installation {
  id                   String        @id @default(uuid())
  githubInstallationId BigInt        @unique
  accountLogin         String
  accountType          String        @default("User") // "User" or "Organization"
  avatarUrl            String?
  plan                 PlanTier      @default(FREE)
  marketplacePlanId    BigInt?
  marketplacePlanName  String?
  marketplaceUnitCount Int           @default(1)
  marketplaceStatus    String        @default("ACTIVE")
  billingCycle         String        @default("monthly")
  nextBillingDate      DateTime?
  userId               String?
  user                 User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  repositories         Repository[]
  usageLedgers         UsageLedger[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("installations")
}

model Repository {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId String?
  installation   Installation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  githubRepoId   BigInt
  fullName       String
  isPrivate      Boolean       @default(false)
  webhookId      String?
  isActive       Boolean       @default(true)
  lastScannedSha String?       // default-branch head last seen by the repo poller (webhook-less repos)
  createdAt      DateTime      @default(now())
  analysisJobs   AnalysisJob[]

  @@map("repositories")
}

enum EventType {
  PULL_REQUEST
  PUSH
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model AnalysisJob {
  id           String     @id @default(uuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  eventType    EventType
  referenceId  String     // PR number or Commit SHA
  status       JobStatus  @default(QUEUED)
  results      Json?
  commitSha    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([repositoryId, eventType, referenceId, commitSha])
  @@index([commitSha])
  @@map("analysis_jobs")
}

model UsageLedger {
  id                  String       @id @default(uuid())
  installationId      String
  installation        Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  billingMonth        String       // format "YYYY-MM"
  publicReviewsCount  Int          @default(0)
  privateReviewsCount Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([installationId, billingMonth])
  @@map("usage_ledgers")
}
