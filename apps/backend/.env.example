# --- Server ---
PORT=4000
NODE_ENV=development
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# --- Database / Cache ---
DATABASE_URL=postgresql://reviewer_user:reviewer_password@localhost:5432/ai_reviewer_db
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Crypto ---
# 32+ char secret for AES-256-GCM vault encryption
ENCRYPTION_KEY=
# Signing key for JWT auth cookies. Must be set — there is no default value.
#   openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- GitHub App (Multi-Tenant Production Setup) ---
# GitHub App ID from https://github.com/settings/apps/<your-app>
GITHUB_APP_ID=
GITHUB_APP_SLUG=pull-pilot-shehzaib
# GitHub App Private Key (raw PEM string with newlines or base64 encoded)
GITHUB_APP_PRIVATE_KEY=
# Or absolute/relative path to your .pem private key file:
GITHUB_APP_PRIVATE_KEY_PATH=
# Webhook secret configured on your GitHub App settings
GITHUB_WEBHOOK_SECRET=

# --- Polar Billing (Merchant of Record) ---
# Organization access token: Polar dashboard -> Settings -> Developers -> Access tokens
POLAR_ACCESS_TOKEN=
# Signing secret from the Polar webhook endpoint (POST /api/billing/webhook)
POLAR_WEBHOOK_SECRET=
# Set to true to use Polar's sandbox environment during local testing
POLAR_SANDBOX=false
# Product IDs from Polar -> Products (one per tier per billing cycle)
POLAR_PRODUCT_INDIE_MONTHLY=
POLAR_PRODUCT_INDIE_YEARLY=
POLAR_PRODUCT_TEAM_MONTHLY=
POLAR_PRODUCT_TEAM_YEARLY=

# --- GitHub OAuth / Legacy PAT (Optional / Local Dev Fallback) ---
# OAuth App credentials for user login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional fallback bot Personal Access Token (for local dev without GitHub App)
# Private repositories also require verifying the signed-in user's effective
# permission via GitHub's collaborators/permission API. Unverifiable access is denied.
GITHUB_ACCESS_TOKEN=

# --- AI provider model overrides (optional) ---
CLAUDE_MODEL=claude-sonnet-4-6
GROK_MODEL=grok-2-1212
GROK_BASE_URL=https://api.x.ai/v1

# --- Repo poller (local-dev webhook substitute) ---
# Reviews new commits/PRs on connected repos that have no webhook installed.
REPO_POLL_ENABLED=true
REPO_POLL_INTERVAL_MS=60000

# --- External security scanners (optional) ---
# Dependency advisories are queried from OSV.dev by default.
OSV_API_URL=https://api.osv.dev
OSV_QUERY_TIMEOUT_MS=8000
OSV_MAX_BATCH=200
# Semgrep is opt-in per repo (security.semgrep). Point SEMGREP_BIN at the
# binary if it is not on PATH; SEMGREP_RULES selects the config registry.
SEMGREP_BIN=semgrep
SEMGREP_RULES=p/security-audit
SEMGREP_TIMEOUT_MS=120000
# Behavioral verification is opt-in per repository. Must match owner-CI AIPR_OIDC_AUDIENCE.
BEHAVIORAL_OIDC_AUDIENCE=
# Import discovery (separate from the AI prompt's context file/token limits).
CONTEXT_INDEX_MAX_FILES=1000
CONTEXT_INDEX_MAX_DOWNLOADS=100
CONTEXT_INDEX_MAX_BYTES=10485760
CONTEXT_INDEX_TIMEOUT_MS=20000
CONTEXT_INDEX_CONCURRENCY=4
