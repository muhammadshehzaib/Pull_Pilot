{
  "name": "ai-pr-reviewer",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "benchmark:corpus": "node benchmarks/build-corpus.cjs",
    "benchmark:fetch-prs": "node benchmarks/fetch-real-prs.cjs",
    "benchmark": "node benchmarks/run.cjs",
    "benchmark:test": "node --test benchmarks/*.test.cjs",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:worker": "npm run dev:worker --workspace=apps/backend",
    "dev:web": "npm run dev --workspace=apps/web",
    "prisma:push": "node ./apps/backend/node_modules/prisma/build/index.js db push --schema ./apps/backend/prisma/schema.prisma",
    "prisma:generate": "node ./apps/backend/node_modules/prisma/build/index.js generate --schema ./apps/backend/prisma/schema.prisma"
  }
}
