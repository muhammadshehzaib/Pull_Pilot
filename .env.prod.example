# Copy to .env.prod next to docker-compose.prod.yml and fill in. Never commit .env.prod.
POSTGRES_PASSWORD=
# 32+ chars, `openssl rand -hex 32` — losing this makes saved vault keys unrecoverable
ENCRYPTION_KEY=
# `openssl rand -hex 32`. Must be set — there is no default value.
JWT_SECRET=
# GitHub OAuth App with callback https://reviewerapi.shehzaib.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitHub App (multi-tenant auth) ---
# App ID from: Settings -> Developer settings -> GitHub Apps -> your app -> General
GITHUB_APP_ID=
# No value needed here. docker-compose.prod.yml mounts ./secrets/github-app.pem into
# the container and passes the path automatically. See deploy/DEPLOY.md step 1b.

# Fallback only. Used when the GitHub App is not configured, e.g. a webhook that
# carries no installation id. Leave the PAT scopes to minimum if you keep this.
GITHUB_ACCESS_TOKEN=
# Random string; used to HMAC-verify inbound webhooks
GITHUB_WEBHOOK_SECRET=

# Optional overrides
GROK_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROK_BASE_URL=https://api.groq.com/openai/v1
REPO_POLL_INTERVAL_MS=60000
# Days to keep failed review jobs (full diff + AI response) in Redis and Postgres
# before they are dropped. Completed jobs are kept indefinitely — they are the
# review history in /history. Set JOB_RETENTION_SWEEP=false to disable the sweep.
JOB_RETENTION_DAYS=7
JOB_SWEEP_INTERVAL_MS=21600000
