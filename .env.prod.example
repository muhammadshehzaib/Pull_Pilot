# Copy to .env.prod next to docker-compose.prod.yml and fill in. Never commit .env.prod.
POSTGRES_PASSWORD=
# 32+ chars, `openssl rand -hex 32` — losing this makes saved vault keys unrecoverable
ENCRYPTION_KEY=
# `openssl rand -hex 32`. Must be set — there is no default value.
JWT_SECRET=
# GitHub OAuth App with callback https://reviewerapi.shehzaib.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitHub App (multi-tenant auth) ---
# App ID from: Settings -> Developer settings -> GitHub Apps -> your app -> General
GITHUB_APP_ID=
# No value needed here. docker-compose.prod.yml mounts ./secrets/github-app.pem into
# the container and passes the path automatically. See deploy/DEPLOY.md step 1b.

# Fallback only. Used when the GitHub App is not configured, e.g. a webhook that
# carries no installation id. Leave the PAT scopes to minimum if you keep this.
GITHUB_ACCESS_TOKEN=
# Random string; used to HMAC-verify inbound webhooks
GITHUB_WEBHOOK_SECRET=

# --- Polar billing (merchant of record) ---
# Organization access token: Polar dashboard -> Settings -> Developers -> Access tokens.
# Use an organization token scoped to Checkouts (write) and Webhooks; keep it secret.
POLAR_ACCESS_TOKEN=
# Webhook signing secret shown when you create the endpoint (POST /api/billing/webhook).
POLAR_WEBHOOK_SECRET=
# "true" points the SDK at sandbox-api.polar.sh. Leave false in production.
POLAR_SANDBOX=false
# Product IDs from Polar -> Products. One product per tier per billing cycle.
# Prices must match the app catalog: Indie $2/mo, $10/yr; Team $5/user/mo, $50/user/yr.
POLAR_PRODUCT_INDIE_MONTHLY=
POLAR_PRODUCT_INDIE_YEARLY=
POLAR_PRODUCT_TEAM_MONTHLY=
POLAR_PRODUCT_TEAM_YEARLY=

# Optional overrides
GROK_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROK_BASE_URL=https://api.groq.com/openai/v1
REPO_POLL_INTERVAL_MS=60000
# Days to keep failed review jobs (full diff + AI response) in Redis and Postgres
# before they are dropped. Completed jobs are kept indefinitely — they are the
# review history in /history. Set JOB_RETENTION_SWEEP=false to disable the sweep.
JOB_RETENTION_DAYS=7
JOB_SWEEP_INTERVAL_MS=21600000

# --- Review context cache ---
# How long cached repository source files are kept, in hours.
# 0 (default) = kept until the repository is disconnected, then deleted by
# cascade. A positive value opts into automatic deletion by the hourly sweep.
# Must match NEXT_PUBLIC_CODE_RETENTION_HOURS on the web app: the privacy
# policy publishes this as a factual promise, so a mismatch makes the site lie.
CONTEXT_RETENTION_HOURS=0
# Platform ceilings for per-repo context. A repository's .aipr.yml may ask for
# a smaller budget but is clamped to these, so one config cannot raise cost.
CONTEXT_MAX_HOPS=2
CONTEXT_MAX_FILES=25
CONTEXT_MAX_TOKENS=30000
