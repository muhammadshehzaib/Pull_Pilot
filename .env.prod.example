# Copy to .env.prod next to docker-compose.prod.yml and fill in. Never commit .env.prod.
POSTGRES_PASSWORD=
# 32+ chars, `openssl rand -hex 32` — losing this makes saved vault keys unrecoverable
ENCRYPTION_KEY=
# `openssl rand -hex 32`. Must be set — there is no default value.
JWT_SECRET=
# GitHub OAuth App with callback https://reviewerapi.shehzaib.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Bot PAT (repo + admin:repo_hook) used for webhooks, diffs, and PR comments
GITHUB_ACCESS_TOKEN=
# Random string; used to HMAC-verify inbound webhooks
# Random string; used to HMAC-verify inbound webhooks
GITHUB_WEBHOOK_SECRET=
# Optional overrides
GROK_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROK_BASE_URL=https://api.groq.com/openai/v1
REPO_POLL_INTERVAL_MS=60000
